---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { proyectos } from "../data/proyectos";
import { perfil, principios, softSkills } from "../data/perfil";
import { experiencia } from "../data/experiencia";
---

<BaseLayout title="Inicio">
  <section class="hero card">
    <div class="hero__media">
      <div class="hero__photo-frame">
        <span class="hero__photo-corner hero__photo-corner--tl" aria-hidden="true"></span>
        <span class="hero__photo-corner hero__photo-corner--tr" aria-hidden="true"></span>
        <span class="hero__photo-corner hero__photo-corner--bl" aria-hidden="true"></span>
        <span class="hero__photo-corner hero__photo-corner--br" aria-hidden="true"></span>
        <div class="hero__photo-circle">
          <img class="hero__avatar" src={perfil.foto} alt={`Retrato de ${perfil.nombre}`} />
        </div>
      </div>
    </div>
    <div class="hero__content">
      <div class="hero__meta">
        <span class="badge"><span class="badge__dot" aria-hidden="true"></span>{perfil.disponibilidad}</span>
        <span class="hero__location">{perfil.ubicacion}</span>
      </div>
      <p class="hero__whoami"><span class="prompt">$</span> whoami → {perfil.nombre}<span class="hero__cursor" aria-hidden="true"></span></p>
      <h1>{perfil.titular}</h1>
      <p class="hero__lead">{perfil.bio}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={`mailto:${perfil.email}`}>{perfil.email}</a>
        <a class="btn" href={perfil.cv}>CV.pdf</a>
        <a class="btn btn--icon" href={perfil.github} aria-label="Perfil de GitHub">
          <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.754-1.333-1.754-1.089-.745.084-.729.084-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
        </a>
        <a class="btn btn--icon" href={perfil.linkedin} aria-label="Perfil de LinkedIn">
          <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <SectionHeading etiqueta="proyectos" href="/proyectos" textoEnlace="ver todos →" />
    <div class="projects-grid">
      {proyectos.map((proyecto) => <ProjectCard {...proyecto} />)}
    </div>
  </section>

  <section class="section columns card">
    <div class="column">
      <SectionHeading etiqueta="cómo desarrollo" />
      <ul class="feature-list">
        {
          principios.map((principio) => (
            <li class="feature-list__item">
              <strong>{principio.titulo}</strong>
              <p>{principio.descripcion}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="column">
      <SectionHeading etiqueta="experiencia" />
      <ol class="timeline">
        {
          experiencia.map((item) => (
            <li class="timeline__item">
              <span class="timeline__periodo">{item.periodo}</span>
              <span class="timeline__titulo">{item.titulo}</span>
            </li>
          ))
        }
      </ol>
      <a class="link-arrow" href="/trayectoria">trayectoria completa →</a>
    </div>

    <div class="column">
      <SectionHeading etiqueta="soft skills" />
      <ul class="tags">
        {softSkills.map((skill) => <li class="tag">{skill}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
